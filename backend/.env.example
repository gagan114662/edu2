# Firebase Admin SDK Configuration
FIREBASE_ADMIN_SDK_CREDENTIALS_PATH="path/to/your/serviceAccountKey.json" # REPLACE with actual path or ensure GOOGLE_APPLICATION_CREDENTIALS is set

# Database Configuration (Still needed for user profiles)
DATABASE_URL="postgresql://user:password@localhost:5432/dbname" # REPLACE with your actual DB connection string

# Frontend URL (Still potentially useful for CORS or other settings)
FRONTEND_URL="http://localhost:3000"

# Gemini API Configuration
GEMINI_API_KEY="YOUR_GEMINI_API_KEY" # REPLACE with your actual Gemini API Key
GEMINI_LIVE_API_ENDPOINT_URL="wss://your-gemini-live-api-endpoint" # REPLACE with the actual WebSocket endpoint URL

# Optional: For some configurations, you might still need these for Firebase Admin if not using a service account file directly
# GOOGLE_CLOUD_PROJECT="your-firebase-project-id"

# Removed Variables (No longer needed for Firebase Auth backend):
# GOOGLE_CLIENT_ID="YOUR_GOOGLE_CLIENT_ID"
# GOOGLE_CLIENT_SECRET="YOUR_GOOGLE_CLIENT_SECRET"
# GOOGLE_REDIRECT_URI="http://localhost:8000/auth/google/callback"
# JWT_SECRET_KEY="your_super_secret_jwt_key_change_me"
# ACCESS_TOKEN_EXPIRE_MINUTES="30"
